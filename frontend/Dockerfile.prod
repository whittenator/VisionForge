# Production frontend image: build the Vite SPA, then serve the static
# bundle with nginx (which also reverse-proxies API calls to the backend).
#
#   docker build -f frontend/Dockerfile.prod -t visionforge/frontend:prod ./frontend
#
# Optionally bake an absolute API base URL at build time:
#   --build-arg VITE_API_URL=https://api.example.com
# If left empty, the SPA talks to the same origin and nginx proxies /api,
# /auth, /health and /metrics to the backend (see nginx.conf).

# --- Build stage ---------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci || npm install

COPY . .

ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# --- Runtime stage -------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

# SPA + API reverse-proxy config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Static assets produced by `vite build`
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost/healthz >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
